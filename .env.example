# ── Django ────────────────────────────────────────────────────────────────
# DEBUG defaults to False (fails safe in production).
DEBUG=True

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(50))"
SECRET_KEY=change-me-to-a-long-random-string

# Required in production for encrypting user API credentials at rest.
# Separate from SECRET_KEY so each can be rotated independently.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: Changing this key without re-encrypting stored credentials will
# make all existing provider API keys unreadable. Back it up securely.
# FERNET_KEY is accepted as a legacy alias for ENCRYPTION_KEY.
ENCRYPTION_KEY=

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Browser origins allowed to call the API (needed when the frontend is
# served from a different origin in production).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ── Database (PostgreSQL + pgvector, see infra/docker-compose.yml) ───────
# Docker maps Postgres to host port 5433 because a local PostgreSQL owns 5432.
POSTGRES_DB=agent_db
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Use SQLite instead of PostgreSQL (local smoke tests only).
USE_SQLITE=False

# ── Redis / Celery ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── AI Provider ──────────────────────────────────────────────────────────
# mock | ollama | openai | gemini | groq | getunikey | opencode
# grok is an alias for groq (GROK_API_KEY = GROQ_API_KEY).
AI_PROVIDER=mock
AI_EMBEDDING_DIM=384
# Set to False to always use deterministic templates instead of LLM prose.
AI_ENHANCE_PROSE=True

# Ollama (only when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenAI (only when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.5

# Google Gemini (only when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Groq (only when AI_PROVIDER=groq or grok)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# GetUniKey (only when AI_PROVIDER=getunikey)
GETUNIKEY_API_KEY=
GETUNIKEY_MODEL=gpt-5.5

# OpenCode (only when AI_PROVIDER=opencode)
OPENCODE_API_KEY=
OPENCODE_MODEL=big-pickle

# ── Auth / OAuth ─────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7
# Sign-in via GitHub/Google OAuth; the GitHub data integration uses
# GITHUB_CLIENT_ID/SECRET directly (credentials flow) and works without it.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOW_OAUTH=False
ALLOW_SIGNUP=True
# Seed the superuser for `python manage.py init_admin --password <pw>`
# (or create one with `python manage.py createsuperuser`).
ADMIN_PASSWORD=

# ── Notifications ────────────────────────────────────────────────────────
NOTIFY_EMAIL_FROM=
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=

# ── Observability ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Enables Sentry (Django + Celery) when DEBUG=False.
SENTRY_DSN=
