# ── Django ────────────────────────────────────────────────────────────────
# In production, set DEBUG=False and provide strong random keys.
DEBUG=True

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(50))"
SECRET_KEY=change-me-to-a-long-random-string

# Required in production for encrypting user API credentials at rest.
# Separate from SECRET_KEY so each can be rotated independently.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: Changing this key without re-encrypting stored credentials will
# make all existing provider API keys unreadable. Back it up securely.
FERNET_KEY=

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Database (PostgreSQL + pgvector, see infra/docker-compose.yml) ───────
# Docker maps Postgres to host port 5433 because a local PostgreSQL owns 5432.
POSTGRES_DB=agent_db
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ── Redis / Celery ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── AI Provider ──────────────────────────────────────────────────────────
# mock | ollama | openai | gemini
AI_PROVIDER=mock
AI_EMBEDDING_DIM=384

# Ollama (only when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenAI (only when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Google Gemini (only when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# ── Auth / OAuth ─────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7
# Manual OAuth code-exchange flows; leave unset to disable (401 on /oauth/*)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOW_OAUTH=False
ALLOW_SIGNUP=True

# ── Notifications ────────────────────────────────────────────────────────
NOTIFY_EMAIL_FROM=
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=
